# Configuration for APP_ENV=dev.
#
# Every non-secret value lives here and nowhere else -- the code carries no
# defaults. Secrets (DATABASE_URL, FA_API_TOKEN) go in .env, which is not
# committed and overrides this file. Real environment variables override both.

# --- Application --------------------------------------------------------
APP_NAME=PDF Receipt Extraction
DEBUG=true

# --- Database -----------------------------------------------------------
DB_ECHO=false

# --- FastAccounting API -------------------------------------------------
FA_BASE_URL=
FA_API_VERSION=v1.5
FA_TIMEOUT_SECONDS=60

# --- Retention ----------------------------------------------------------
DOCUMENT_TTL_DAYS=7

# --- OCR presentation ---------------------------------------------------
OCR_LOW_CONFIDENCE_THRESHOLD=0.80

# --- Background worker --------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5
WORKER_CLAIM_TIMEOUT_SECONDS=300

# --- Storage ------------------------------------------------------------
STORAGE_DIR=storage
