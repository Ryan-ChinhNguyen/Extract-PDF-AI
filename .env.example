# Local secrets only. Copy to .env and fill in; .env is not committed.
# Every other setting lives in config/<APP_ENV>.env -- change it there.

# Which config/<name>.env to load. Only "dev" exists today.
APP_ENV=dev

# --- Database -----------------------------------------------------------
# asyncpg driver is required (SQLAlchemy async engine).
DATABASE_URL=postgresql+asyncpg://pdfx:pdfx@localhost:5432/pdfx

# --- FastAccounting API -------------------------------------------------
# Token lives in FA_Assignment_Backend(FY26Ver)/API Reference/api_token.txt.
FA_API_TOKEN=
