# --- Database -----------------------------------------------------------
# asyncpg driver is required (SQLAlchemy async engine).
DATABASE_URL=postgresql+asyncpg://pdfx:pdfx@localhost:5432/pdfx
DB_ECHO=false

# --- FastAccounting API -------------------------------------------------
# Token lives in FA_Assignment_Backend(FY26Ver)/API Reference/api_token.txt.
# Never commit the real value; copy this file to .env and fill it in there.
FA_API_TOKEN=
FA_BASE_URL=https://api-gt01-sandbox.fastaccounting.jp/fa
FA_API_VERSION=v1.5
FA_TIMEOUT_SECONDS=60

# --- Retention ----------------------------------------------------------
# How long an uploaded document stays re-runnable. After this window the
# content hash is released and the same file may be uploaded again.
DOCUMENT_TTL_DAYS=7

# --- OCR presentation ---------------------------------------------------
# Fields the engine scored below this are flagged on screen for checking.
# Display only: nothing is rejected or retried because of it.
OCR_LOW_CONFIDENCE_THRESHOLD=0.80

# --- Background worker --------------------------------------------------
# Set WORKER_ENABLED=false to run an API-only process (e.g. several web
# replicas plus one worker replica).
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5
WORKER_CLAIM_TIMEOUT_SECONDS=300

# --- Storage ------------------------------------------------------------
STORAGE_DIR=storage
